#!/usr/bin/env bash
# Runs Claude Code against Muse for this folder only. Variables live and die with this process.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

key=""
if [[ -f .env ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*MODEL_API_KEY[[:space:]]*=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
    fi
  done < .env
fi
key="${key#"${key%%[![:space:]]*}"}"
key="${key%"${key##*[![:space:]]}"}"
if [[ ${#key} -ge 2 && ( ${key:0:1} == '"' || ${key:0:1} == "'" ) && ${key: -1} == "${key:0:1}" ]]; then
  key="${key:1:${#key}-2}"
fi

if [[ -z "$key" ]]; then
  echo "MODEL_API_KEY is empty in $(pwd)/.env. Paste your key there first." >&2
  exit 1
fi

export ANTHROPIC_BASE_URL=https://api.meta.ai
export ANTHROPIC_AUTH_TOKEN="$key"
export ANTHROPIC_MODEL=muse-wonder-1.0
export ANTHROPIC_DEFAULT_OPUS_MODEL=muse-wonder-1.0
export ANTHROPIC_DEFAULT_SONNET_MODEL=muse-wonder-1.0
export ANTHROPIC_DEFAULT_HAIKU_MODEL=muse-wonder-1.0
export CLAUDE_CODE_SUBAGENT_MODEL=muse-wonder-1.0
export ENABLE_TOOL_SEARCH=true
unset key

exec claude "$@"
